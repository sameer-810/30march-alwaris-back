{
  "name": "alwaris-backend",
  "version": "1.0.0",
  "description": "Alwaris Logistics ERP Backend (Node.js + Express + MongoDB)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run format",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:employees": "node scripts/seedEmployees.js",
    "seed:masters": "node scripts/seedMasters.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.911.0",
    "@aws-sdk/s3-request-presigner": "^3.911.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  }
}
